{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "pdp": {
      "type": "object",
      "properties": {
        "emrtd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "registryName": { "type": "string", "minLength": 1 },
            "description": { "type": "string" },
            "pathLenMode": { "type": "string", "enum": ["", "ignore", "enforce"] },
            "pathLenOverride": { "type": ["integer", "null"], "minimum": 0 },
            "watch": { "type": "boolean" },
            "anchors": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": { "type": "string" },
                "pullPolicy": { "type": "string", "enum": ["", "Always", "IfNotPresent", "Never"] },
                "pullSecrets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "resources": { "type": "object" }
              }
            },
            "crls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
